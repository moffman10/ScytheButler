@page "/"
@attribute [Authorize]
@namespace Dashboard.Web.Components.Pages
@using Microsoft.AspNetCore.Authorization

<PageTitle>Home - Scythebound Dashboard</PageTitle>

<div class="fixed-hero-container">
    <!-- Background Image -->
    <img src="/Resources/Images/Backgrounds/HomePageBackground.png" alt="Scythebound Background" class="hero-background" />

    <!-- Hero Content Wrapper for Icon and Gold Paragraphs -->
    <div class="hero-content-wrapper">
        <!-- Left Paragraph -->
        <div class="gold-side-text left-text">
            <span class="gold-header">Welcome, Staff</span>
            Sharper than our scythes are our vibes. Here lies the core command centre for Scythebound—overseeing our raids, maintaining order in World 521, and ensuring our PvM community stays legendary!
        </div>

        <!-- Center Icon -->
        <img src="/Resources/Images/Icons/icon.png" alt="Scythebutler Icon" class="hero-overlay-icon" />

        <!-- Right Paragraph -->
        <div class="gold-side-text right-text">
            <span class="gold-header">Scythebutler Active</span>
            Managed in C# and built exclusively for the staff team. Monitor progress, handle clan administration, and keep the chaos organised.<br>
            Community, progress, chaos.<br>
            let's pot up!
        </div>
    </div>
</div>